    "import numpy as np\n",
    "from scipy.linalg import circulant # 循环矩阵\n",
    "\n",
    "n = 3\n",
    "p = np.random.rand(n)\n",
    "\n",
    "print(p)\n",
    "c = circulant(p) # \n",
    "print(c)\n"
   ]
  },
